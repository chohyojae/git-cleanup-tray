// 등록 저장소 목록을 보여주는 메인 창 (PLAN 10장).
// 사용자가 Open을 선택했을 때만 생성하고, 닫으면 Rust 쪽에서 instance를 drop해 메모리를 돌려준다.

import { Button, VerticalBox, HorizontalBox, ListView, Palette } from "std-widgets.slint";
import { RepositoryRowData } from "components/types.slint";
import { RepositoryRow } from "repository-row.slint";

export component MainWindow inherits Window {
    // 등록 저장소 목록. Rust 쪽 `VecModel`을 재사용해 바뀐 줄만 갱신한다.
    in property <[RepositoryRowData]> repositories;
    // 작업 실행 중에는 변경 작업 버튼을 비활성화한다.
    in property <bool> busy: false;
    // 변경 작업·확인 대기·취소 중일 때만 새 Scan을 막는다.
    in property <bool> scan-blocked: false;
    // native 폴더 선택 창이 열려 있으면 Add 버튼의 중복 실행을 막는다.
    in property <bool> picking-folders: false;
    // 탐색기/Finder에서 경로를 창 위로 끌어오는 동안 추가 안내를 보여준다.
    in property <bool> drag-hover: false;
    // 진행 상황 ("Scanning 2 of 5: Project B"). 비어 있으면 진행 표시줄을 숨긴다.
    in property <string> progress;
    // 진행 중인 작업을 취소할 수 있으면 `true` (Scan, Clean).
    in property <bool> can-cancel: false;
    // 하단 안내 문구 (저장소 추가 실패 등). 비어 있으면 숨긴다.
    in property <string> notice;

    // 상단 버튼 요청. 처리 로직은 Rust(app module)에 둔다.
    callback add-requested();
    callback scan-all-requested();
    callback clean-all-requested();
    // 등록된 remote를 fetch하고 로컬 브랜치를 fast-forward한다.
    callback update-all-requested();
    callback settings-requested();
    callback cancel-requested();
    // 저장소 줄 요청. 인자는 `repositories` 안의 index다.
    callback scan-requested(int);
    callback clean-requested(int);
    // 저장소 하나를 fetch하고 최신화한다.
    callback update-requested(int);
    callback details-requested(int);
    callback edit-requested(int);
    callback toggle-requested(int);
    callback open-folder-requested(int);
    callback open-terminal-requested(int);
    callback remove-requested(int);

    title: "Git Cleanup Tray";
    preferred-width: 780px;
    preferred-height: 480px;
    min-width: 740px;
    min-height: 320px;

    VerticalBox {
        HorizontalBox {
            padding: 0;
            Text {
                text: "Repositories";
                font-size: 18px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Add…";
                enabled: !root.busy && !root.picking-folders;
                clicked => { root.add-requested(); }
            }
            Button {
                text: "Scan All";
                enabled: !root.scan-blocked;
                clicked => { root.scan-all-requested(); }
            }
            Button {
                text: "Clean All";
                enabled: !root.busy;
                clicked => { root.clean-all-requested(); }
            }
            Button {
                text: "Update All";
                enabled: !root.busy;
                clicked => { root.update-all-requested(); }
            }
            Button {
                text: "Settings";
                clicked => { root.settings-requested(); }
            }
        }

        Text {
            text: "Select multiple folders with Add… or drop them here.";
            font-size: 12px;
            opacity: 0.7;
            wrap: word-wrap;
        }

        if root.repositories.length == 0: Text {
            text: "No repositories registered. Add or drop Git repository folders to get started.";
            wrap: word-wrap;
            vertical-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.repositories.length > 0: ListView {
            vertical-stretch: 1;
            for row[index] in root.repositories: VerticalLayout {
                padding-bottom: 6px;
                RepositoryRow {
                    data: row;
                    busy: root.busy;
                    scan-blocked: root.scan-blocked;
                    scan => { root.scan-requested(index); }
                    update => { root.update-requested(index); }
                    clean => { root.clean-requested(index); }
                    details => { root.details-requested(index); }
                    edit => { root.edit-requested(index); }
                    toggle-enabled => { root.toggle-requested(index); }
                    open-folder => { root.open-folder-requested(index); }
                    open-terminal => { root.open-terminal-requested(index); }
                    remove => { root.remove-requested(index); }
                }
            }
        }

        if root.progress != "": HorizontalBox {
            padding: 0;
            Text {
                text: root.progress;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.can-cancel: Button {
                text: "Cancel";
                clicked => { root.cancel-requested(); }
            }
        }
        if root.notice != "": Text {
            text: root.notice;
            wrap: word-wrap;
        }
    }

    // OS의 drop 이벤트는 Rust에서 받는다. 이 영역은 추가 동작을 안내하기만 한다.
    if root.drag-hover: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Palette.background;
        border-width: 2px;
        border-color: Palette.border;
        Text {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: parent.height - 48px;
            text: root.busy
                ? "Drop repository folders here.\nThey will be added after the current operation."
                : "Drop folders to add repositories";
            font-size: 18px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
