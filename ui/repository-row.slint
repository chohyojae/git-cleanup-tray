// 메인 창 저장소 목록의 한 줄 (PLAN 10장).
// 상태는 색상이 아니라 문구로 보여준다 (PLAN 23장).

import { Palette } from "std-widgets.slint";
import { RepositoryRowData } from "components/types.slint";
import { ActionButton, MutedText } from "components/style.slint";

export component RepositoryRow inherits Rectangle {
    // 표시할 저장소 정보.
    in property <RepositoryRowData> data;
    // 작업 실행 중에는 변경 작업 버튼을 비활성화한다.
    in property <bool> busy;
    // 다른 저장소의 Scan 중에는 이 저장소의 Scan을 허용한다.
    in property <bool> scan-blocked;

    // 줄 단위 요청. 어떤 저장소인지는 메인 창이 index로 붙인다.
    callback scan();
    callback clean();
    // 이 저장소를 fetch하고 최신화한다.
    callback update();
    callback details();
    callback edit();
    callback toggle-enabled();
    callback open-folder();
    callback open-terminal();
    callback remove();

    border-width: 1px;
    border-radius: 8px;
    border-color: Palette.border;
    background: Palette.alternate-background;
    vertical-stretch: 0;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 16px;
            Text {
                text: root.data.enabled ? root.data.name : root.data.name + " (disabled)";
                font-size: 15px;
                font-weight: 600;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.data.status;
                max-width: 300px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 16px;
            MutedText {
                text: root.data.path;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.data.base != "": MutedText {
                text: "Base: " + root.data.base;
                max-width: 220px;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
        HorizontalLayout {
            // 남는 세로 공간을 버튼에 배분하지 않도록 작업 행의 높이를 고정한다.
            height: 34px;
            spacing: 8px;
            MutedText {
                text: root.data.activity;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            ActionButton {
                text: "Scan";
                enabled: !root.scan-blocked && !root.data.scan-pending;
                clicked => { root.scan(); }
            }
            ActionButton {
                text: "Clean";
                enabled: !root.busy;
                clicked => { root.clean(); }
            }
            ActionButton {
                text: "Update";
                enabled: !root.busy;
                clicked => { root.update(); }
            }
            ActionButton {
                text: "Details";
                enabled: !root.busy;
                clicked => { root.details(); }
            }
            more-button := ActionButton {
                text: "More";
                clicked => { more.show(); }
            }
        }
    }

    // More 버튼 아래에 뜨는 메뉴. 저장소 자체를 바꾸지 않는 동작만 둔다.
    more := PopupWindow {
        x: more-button.x + more-button.width - 160px;
        y: root.height - 4px;
        width: 160px;

        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-radius: 8px;
            border-color: Palette.border;
        }
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            ActionButton {
                text: "Edit…";
                horizontal-stretch: 1;
                enabled: !root.busy;
                clicked => { root.edit(); }
            }
            ActionButton {
                text: root.data.enabled ? "Disable" : "Enable";
                horizontal-stretch: 1;
                enabled: !root.busy;
                clicked => { root.toggle-enabled(); }
            }
            ActionButton {
                text: "Open Folder";
                horizontal-stretch: 1;
                clicked => { root.open-folder(); }
            }
            ActionButton {
                text: "Open Terminal";
                horizontal-stretch: 1;
                clicked => { root.open-terminal(); }
            }
            ActionButton {
                text: "Remove";
                horizontal-stretch: 1;
                enabled: !root.busy;
                clicked => { root.remove(); }
            }
        }
    }
}
