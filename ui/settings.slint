// 앱 설정 창 (PLAN 15장).
// dirty worktree skip, force 삭제 금지, remote branch 삭제 금지는 설정이 아니라 불변조건이라 여기에 없다.

import { CheckBox, LineEdit, TextEdit, GridBox, GroupBox, ScrollView } from "std-widgets.slint";
import { ActionButton, ActionBar, PageLayout, SectionTitle, MutedText } from "components/style.slint";

export component SettingsWindow inherits Window {
    // General
    // login 시 자동 시작.
    in-out property <bool> start-at-login;
    // 시작 시 메인 창 없이 tray로만 시작.
    in-out property <bool> start-minimized;
    // tray icon 좌클릭 시 메인 창 열기 (Windows).
    in-out property <bool> open-on-left-click;
    // Git
    // git 실행 파일 경로. 비우면 PATH에서 찾는다.
    in-out property <string> git-path;
    // 새 저장소의 기본 remote 이름.
    in-out property <string> default-remote;
    // default branch를 모를 때 `git ls-remote` 허용.
    in-out property <bool> allow-remote-query;
    // Cleanup
    // 보호 branch pattern. 한 줄에 하나.
    in-out property <string> protected-patterns;
    // Clean All 전에 확인 dialog 표시.
    in-out property <bool> confirm-clean-all;
    // 간격마다 최신화 후 정리하도록 사용자가 미리 동의한다.
    in-out property <bool> auto-maintenance;
    // 분 단위 간격. Rust에서 1~10080 범위를 검증한다.
    in-out property <string> interval-minutes;
    // 설정 파일 폴더 (표시용).
    in property <string> data-dir;
    // 입력 검증·저장 오류. 비어 있으면 숨긴다.
    in property <string> error;

    // Save 버튼. Rust 쪽에서 검증 후 저장한다.
    callback save();
    // Cancel 버튼. 창 닫기와 같은 처리를 한다.
    callback cancel();
    // 설정 파일 폴더를 Finder/Explorer로 연다.
    callback open-data-dir();

    title: "Settings";
    preferred-width: 620px;
    preferred-height: 720px;
    min-width: 540px;
    min-height: 420px;

    PageLayout {
        SectionTitle { text: "Settings"; }
        // 설정이 화면보다 길어져도 저장·취소 버튼은 아래에 남긴다.
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 16px;
                alignment: start;
                GroupBox {
                    title: "General";
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        CheckBox { text: "Start at login"; checked <=> root.start-at-login; }
                        CheckBox { text: "Start minimized to tray"; checked <=> root.start-minimized; }
                        CheckBox { text: "Open main window on tray left-click"; checked <=> root.open-on-left-click; }
                    }
                }
                GroupBox {
                    title: "Git";
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;
                        GridBox {
                            padding: 0;
                            Row {
                                Text { text: "Git executable"; vertical-alignment: center; }
                                LineEdit { text <=> root.git-path; placeholder-text: "Auto (git on PATH)"; }
                            }
                            Row {
                                Text { text: "Default remote"; vertical-alignment: center; }
                                LineEdit { text <=> root.default-remote; placeholder-text: "origin"; }
                            }
                        }
                        CheckBox {
                            text: "Allow remote query when default branch is unknown";
                            checked <=> root.allow-remote-query;
                        }
                    }
                }
                GroupBox {
                    title: "Cleanup";
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "Protected branch patterns (one per line, * matches anything)"; wrap: word-wrap; }
                        TextEdit { text <=> root.protected-patterns; height: 76px; }
                        CheckBox { text: "Confirm before Clean All"; checked <=> root.confirm-clean-all; }
                    }
                }
                GroupBox {
                    title: "Scheduled update and cleanup";
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        CheckBox {
                            text: "Automatically fetch, update and clean enabled repositories";
                            checked <=> root.auto-maintenance;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Interval (minutes, 1–10080)"; vertical-alignment: center; }
                            LineEdit { text <=> root.interval-minutes; enabled: root.auto-maintenance; }
                        }
                        MutedText {
                            text: "Runs without confirmation while the app is open. The timer pauses during other operations and resumes with the remaining time.";
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    height: 34px;
                    MutedText {
                        text: "Settings folder: " + root.data-dir;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    ActionButton {
                        text: "Open";
                        clicked => { root.open-data-dir(); }
                    }
                }
            }
        }
        // 저장 실패 이유는 스크롤 위치와 상관없이 Save 버튼 옆에서 확인할 수 있어야 한다.
        if root.error != "": Text {
            text: root.error;
            wrap: word-wrap;
            vertical-stretch: 0;
        }
        ActionBar {
            ActionButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            ActionButton {
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}
