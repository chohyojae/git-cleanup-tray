// Clean All 확인과 결과를 보여주는 dialog (PLAN 12, 13장).
// 같은 창이 확인 → 실행 중 → 결과 순서로 바뀐다. Rust 쪽에서 필요할 때만 만들고 닫으면 drop한다.
// 확인 단계에서는 정리할 항목을 체크박스 목록으로 보여주고, 체크한 항목만 정리한다.

import { CheckBox, ScrollView, ListView, Palette } from "std-widgets.slint";
import { CleanupItem } from "components/types.slint";
import { ActionButton, ActionBar, SectionTitle, MutedText, Divider } from "components/style.slint";

// dialog가 보여주는 단계.
export enum DialogStage {
    // 삭제 전 요약과 확인 버튼.
    confirm,
    // 실행 중. 버튼을 비활성화한다.
    running,
    // 실행 결과.
    done,
}

// 삭제 종류별 숫자를 같은 폭으로 보여준다. 상태는 색상이 아니라 문구로 구분한다.
component SummaryMetric inherits VerticalLayout {
    // 항목 이름.
    in property <string> label;
    // 항목 수.
    in property <int> count;

    spacing: 4px;
    alignment: center;
    horizontal-stretch: 1;
    Text {
        text: root.count;
        font-size: 28px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    MutedText {
        text: root.label;
        horizontal-alignment: center;
    }
}

export component CleanupDialog inherits Window {
    // 현재 단계.
    in property <DialogStage> stage: DialogStage.confirm;
    // 상단 제목 (예: "Clean up 16 items?", "Removed 15 items").
    in property <string> heading;
    // confirm 단계의 체크박스 목록. 체크 상태는 사용자가 바꾸고 Rust가 확인 시점에 읽는다.
    in property <[CleanupItem]> items;
    // 체크한 항목 중 커밋하지 않은 변경이나 merge되지 않은 commit을 잃는 항목 수.
    in property <int> forced;
    // confirm 단계에서는 체크한 항목 기준 삭제 예정 수, done 단계에서는 실제 처리 수.
    in property <int> repositories;
    // 삭제할 또는 삭제한 worktree 수.
    in property <int> worktrees;
    // 삭제할 또는 삭제한 local branch 수.
    in property <int> branches;
    // 삭제할 또는 삭제한 custom ref 수.
    in property <int> custom-refs;
    // 건너뛴 항목 수.
    in property <int> skipped;
    // 오류 수.
    in property <int> errors;
    // 사용자가 확인할 오류·건너뜀 상세 ("저장소: 내용"). Rust 쪽에서 개수를 제한해 넘긴다.
    in property <[string]> problems;
    // running 단계의 진행 상황 ("Cleaning 1 of 3: Project A").
    in property <string> progress;

    // confirm 단계의 Clean 버튼. 체크한 항목만 정리한다.
    callback confirmed();
    // 체크 상태가 바뀌었다. Rust가 숫자와 경고를 다시 계산한다.
    callback selection-changed();
    // confirm 단계 Cancel 또는 done 단계 Close 버튼. 창 닫기와 같은 처리를 한다.
    callback dismissed();
    // running 단계 Cancel 버튼. 진행 중인 저장소까지 끝내고 멈춘다.
    callback cancel-run();

    title: "Clean All";
    preferred-width: 600px;
    preferred-height: root.stage == DialogStage.confirm ? 700px
        : root.problems.length > 0 ? 520px : 360px;
    min-width: 460px;
    min-height: 320px;

    VerticalLayout {
        spacing: 0;
        // 본문만 스크롤한다. 단계 전환·최대화 뒤에도 버튼은 아래에서 같은 크기를 유지한다.
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                // 큰 창에서도 숫자와 설명이 양 끝으로 흩어지지 않게 본문 폭을 제한한다.
                padding: 24px;
                Rectangle { horizontal-stretch: 0; }
                VerticalLayout {
                    max-width: 720px;
                    horizontal-stretch: 1;
                    spacing: 20px;
                    alignment: start;
                    VerticalLayout {
                        spacing: 6px;
                        SectionTitle {
                            text: root.heading;
                            wrap: word-wrap;
                        }
                        MutedText {
                            text: root.stage == DialogStage.confirm ? "Review the items selected for cleanup."
                                : root.stage == DialogStage.running ? "Cleanup is in progress."
                                : "Cleanup results";
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 138px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                height: 64px;
                                spacing: 12px;
                                SummaryMetric { label: "Worktrees"; count: root.worktrees; }
                                SummaryMetric { label: "Local branches"; count: root.branches; }
                                SummaryMetric { label: "Custom refs"; count: root.custom-refs; }
                            }
                            Divider { }
                            HorizontalLayout {
                                spacing: 16px;
                                MutedText { text: "Repositories  " + root.repositories; }
                                Rectangle { horizontal-stretch: 1; }
                                MutedText { text: "Skipped  " + root.skipped; }
                                if root.errors > 0: Text {
                                    text: "Errors  " + root.errors;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // 긴 목록은 보이는 행만 만든다. 작업을 잃는 항목은 Rust가 미선택으로 넘긴다.
                    if root.stage == DialogStage.confirm && root.items.length > 0: ListView {
                        height: min(280px, root.items.length * 88px);
                        for item in root.items: VerticalLayout {
                            spacing: 0;
                            HorizontalLayout {
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;
                                CheckBox {
                                    checked: item.checked;
                                    toggled => {
                                        item.checked = self.checked;
                                        root.selection-changed();
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: item.title; wrap: word-wrap; }
                                    MutedText { text: item.note; wrap: word-wrap; }
                                }
                                if item.risky: Text {
                                    text: "Loses work";
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            Divider { }
                        }
                    }

                    // 삭제 범위와 되돌릴 수 없는 항목을 확인 전에 알린다 (PLAN 13장 필수 문구).
                    if root.stage == DialogStage.confirm: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Only checked items are cleaned. Remote branches will not be deleted.";
                            wrap: word-wrap;
                        }
                        MutedText {
                            text: "Items marked \"Loses work\" have uncommitted changes or unmerged commits and are unchecked by default.";
                            wrap: word-wrap;
                        }
                    }

                    if root.stage == DialogStage.running && root.progress != "": Text {
                        text: root.progress;
                        wrap: word-wrap;
                    }
                    if root.problems.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Details"; font-weight: 600; }
                        ListView {
                            height: min(180px, root.problems.length * 64px);
                            for line in root.problems: Text { text: line; wrap: word-wrap; }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 0; }
            }
        }

        // 위험 항목을 체크한 직후 경고가 스크롤 아래에 가려지지 않게 버튼 옆에 둔다.
        if root.stage == DialogStage.confirm && root.forced > 0: VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 16px;
            Text {
                text: "Warning: " + root.forced + " checked item(s) will permanently lose uncommitted changes or unmerged commits. This cannot be undone.";
                font-weight: 600;
                wrap: word-wrap;
            }
        }
        Divider { }
        HorizontalLayout {
            height: 82px;
            padding: 24px;
            ActionBar {
                if root.stage == DialogStage.confirm: ActionButton {
                    text: "Cancel";
                    clicked => { root.dismissed(); }
                }
                if root.stage == DialogStage.running: ActionButton {
                    text: "Cancel";
                    clicked => { root.cancel-run(); }
                }
                if root.stage == DialogStage.confirm: ActionButton {
                    text: "Clean " + (root.worktrees + root.branches + root.custom-refs) + " items";
                    primary: true;
                    // 아무것도 체크하지 않았으면 실행할 것이 없다.
                    enabled: root.worktrees + root.branches + root.custom-refs > 0;
                    clicked => { root.confirmed(); }
                }
                if root.stage == DialogStage.running: ActionButton {
                    text: "Cleaning…";
                    enabled: false;
                }
                if root.stage == DialogStage.done: ActionButton {
                    text: "Close";
                    primary: true;
                    clicked => { root.dismissed(); }
                }
            }
        }
    }
}
